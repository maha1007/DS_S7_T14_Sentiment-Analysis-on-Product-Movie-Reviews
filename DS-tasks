    "#5. Hypothesis Testing — T-test, ANOVA, Z-test\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "\n",
    "# Sample data\n",
    "group1 = [12, 15, 14, 10, 13]\n",
    "group2 = [18, 17, 19, 20, 16]\n",
    "\n",
    "# T-test\n",
    "t_stat, p_value = stats.ttest_ind(group1, group2)\n",
    "\n",
    "print(\"T-test\")\n",
    "print(\"T-statistic:\", t_stat)\n",
    "print(\"P-value:\", p_value)\n",
    "\n",
    "# ANOVA\n",
    "group3 = [11, 13, 12, 14, 15]\n",
    "\n",
    "f_stat, anova_p = stats.f_oneway(\n",
    "    group1,\n",
    "    group2,\n",
    "    group3\n",
    ")\n",
    "\n",
    "print(\"\\nANOVA\")\n",
    "print(\"F-statistic:\", f_stat)\n",
    "print(\"P-value:\", anova_p)\n",
    "\n",
    "# Z-test\n",
    "sample = [12, 15, 14, 13, 16, 15, 14, 12, 13, 15]\n",
    "\n",
    "population_mean = 14\n",
    "\n",
    "sample_mean = np.mean(sample)\n",
    "sample_std = np.std(sample, ddof=1)\n",
    "n = len(sample)\n",
    "\n",
    "z_stat = (sample_mean - population_mean) / (sample_std / np.sqrt(n))\n",
    "\n",
    "print(\"\\nZ-test\")\n",
    "print(\"Z-statistic:\", z_stat)"
   ]
  },
