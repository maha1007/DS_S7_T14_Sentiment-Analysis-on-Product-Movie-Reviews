    "#Dashboards in Python\n",
    "import dash\n",
    "#Dash Core components, used for interactive components such as graphs, dropdowns, sliders, buttons, etc.\n",
    "from dash import dcc, html\n",
    "#creates the new Dash application using variabl name called app\n",
    "#__name__ is a special Python variable that identifies the current python module.\n",
    "app=dash.Dash(__name__)\n",
    "app.layout=html.Div([ #Layout defines what(structure/design of the webpage) appears on the dashboard.\n",
    "    html.H1(\"Dash Tutorial\"), #creates an HTML heading.\n",
    "    dcc.Graph( #creates a graph.\n",
    "        id=\"example\",\n",
    "        figure={\n",
    "            \"data\":[\n",
    "                {\n",
    "                    \"x\":[1, 2, 3, 4, 5],\n",
    "                    \"y\":[5, 4, 7, 4, 8],\n",
    "                    \"type\": \"line\",\n",
    "                    \"name\": \"Trucks\"\n",
    "                },\n",
    "                {\n",
    "                    \"x\":[1, 2, 3, 4, 5],\n",
    "                    \"y\":[6, 3, 5, 3, 7],\n",
    "                    \"type\": \"bar\",\n",
    "                    \"name\": \"Ships\"\n",
    "                }\n",
    "            ],\n",
    "\"layout\": {\n",
    "                \"title\": \"Basic Dashboard\"\n",
    "            }\n",
    "        }\n",
    "    )\n",
    "])\n",
    "app.run(debug=True,port=8051)\n",
    "                    "
   ]
