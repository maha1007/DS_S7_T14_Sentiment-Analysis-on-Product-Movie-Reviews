        "# ==============================\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "data = np.array([10,12,15,18,20,22,25,30,100])\n",
        "plt.boxplot(data)\n",
        "plt.title('Box Plot')\n",
        "plt.show()\n",
        "\n",
        "# IQR method\n",
        "Q1 = np.percentile(data, 25)\n",
        "Q3 = np.percentile(data, 75)\n",
        "IQR = Q3 - Q1\n",
        "lower = Q1 - 1.5 * IQR\n",
        "upper = Q3 + 1.5 * IQR\n",
        "outliers = data[(data < lower) | (data > upper)]\n",
        "print('Q1:', Q1)\n",
        "print('Q3:', Q3)\n",
        "print('IQR:', IQR)\n",
        "print('Lower bound:', lower)\n",
        "print('Upper bound:', upper)\n",
        "print('Outliers:', outliers)\n",
        "\n",
        "# Filtered data (only after deciding an outlier should be excluded)\n",
        "clean_data = data[(data >= lower) & (data <= upper)]\n",
        "print(clean_data)\n",
        "\n",
        "# ==============================\n"
      ]
